# =============================================================================
# Talkzi environment variables
# Copy to apps/web/.env.local (Next.js) and to the repo root .env.local (scripts).
#   Windows (PowerShell):  Copy-Item .env.example apps/web/.env.local
#   macOS/Linux:           cp .env.example apps/web/.env.local
# Every feature degrades gracefully when its keys are missing (stubs/mocks).
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage, Realtime) ----------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string (URI). Used by `pnpm db:migrate`.
DATABASE_URL=
# Optional: used by `pnpm db:types` (supabase gen types --project-id ...)
SUPABASE_PROJECT_ID=

# --- Upstash Redis -----------------------------------------------------------
# REST credentials: rate limiting + caching (@upstash/redis, @upstash/ratelimit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional TCP URL for BullMQ (Upstash console -> "Connect" -> ioredis), e.g.
# rediss://default:<password>@<name>.upstash.io:6379
# When empty, the broadcast queue falls back to a Postgres-backed queue.
REDIS_URL=

# --- Meta / WhatsApp Business Platform ---------------------------------------
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration ID (Facebook Login for Business -> Configurations)
META_CONFIG_ID=
# Any random string; paste the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Optional: your own System User token (admin tasks / single-tenant testing)
META_SYSTEM_USER_TOKEN=
META_GRAPH_API_VERSION=v21.0
# true = simulate all Cloud API calls (no Meta account needed). The seeded demo
# WABA is always simulated regardless of this flag.
WHATSAPP_MOCK=false
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# --- AI ----------------------------------------------------------------------
# openai | anthropic | mock   (mock is used automatically when no key is set)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
ANTHROPIC_MODEL=

# --- Billing -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local payment adapters (stubs until credentials are provided)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# --- Email -------------------------------------------------------------------
# Emails are logged to the console when RESEND_API_KEY is empty.
RESEND_API_KEY=
EMAIL_FROM="Talkzi <hello@talkzi.app>"

# --- Security ----------------------------------------------------------------
# Signs invitation tokens and internal calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
# 32-byte key (64 hex chars or base64) for AES-256-GCM encryption of access tokens.
ENCRYPTION_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Falls back to INTERNAL_API_SECRET.
CRON_SECRET=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
