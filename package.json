{
  "name": "talkzi",
  "version": "0.1.0",
  "private": true,
  "description": "Talkzi — Run your business on WhatsApp. Multi-tenant WhatsApp Business Cloud API SaaS.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @talkzi/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @talkzi/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @talkzi/web lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @talkzi/db migrate",
    "db:seed": "pnpm --filter @talkzi/db seed",
    "db:types": "pnpm --filter @talkzi/db types",
    "db:types:local": "pnpm --filter @talkzi/db types:local"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rimraf": "^6.1.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0"
  }
}
