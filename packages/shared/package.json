{
  "name": "@talkzi/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, types and constants for Talkzi.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
